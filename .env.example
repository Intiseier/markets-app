# ── MarketMeh API Keys ──────────────────────────────────────────
# All keys are optional. The app works without any of them.
# Keys can also be added via the Settings page inside the app.

# Financial Modeling Prep — analyst price targets, ratings, upgrades/downgrades
# Free key: https://financialmodelingprep.com/
FMP_API_KEY=

# Twelve Data — analyst data fallback if FMP is unavailable
# Free key: https://twelvedata.com/
TWELVEDATA_API_KEY=

# AI-powered stock insights (choose one)
# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI ChatGPT: https://platform.openai.com/
OPENAI_API_KEY=

# NewsAPI — enhanced financial news feed
# Free key: https://newsapi.org/
NEWS_API_KEY=
